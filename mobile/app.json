{
  "expo": {
    "name": "Fluent AI",
    "slug": "fluent-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fluentai.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Fluent AI usa o microfone para você praticar conversação e pronúncia."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C4DFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fluentai.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "scheme": "fluentai",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "O Fluent AI usa o microfone para você praticar conversação e pronúncia."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

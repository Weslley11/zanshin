# ---- Copie para backend/.env e ajuste. NUNCA versione o .env real. ----
ENV=development
DATABASE_URL=postgresql+asyncpg://fluent:fluent@localhost:5432/fluent
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# ---- IA generativa (tutor, relatórios, avaliação de fala, documentos) ----
# offline | anthropic | openai_compatible
LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT_CHAT=low
ANTHROPIC_EFFORT_REPORT=medium
ANTHROPIC_ENABLE_FALLBACKS=true

# Compatível com OpenAI (OpenAI, Azure OpenAI, vLLM/Ollama locais...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Voz ----
# none | openai_compatible | azure
STT_PROVIDER=none
OPENAI_STT_MODEL=whisper-1
# device (voz do aparelho, gratuita) | openai_compatible | azure
TTS_PROVIDER=device
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# none | azure  (notas por fonema)
PRONUNCIATION_PROVIDER=none
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---- Custos (limites diários por usuário e teto global) ----
DAILY_LLM_TOKENS_PER_USER=250000
DAILY_STT_SECONDS_PER_USER=3600
DAILY_TTS_CHARS_PER_USER=60000
GLOBAL_DAILY_COST_LIMIT_USD=50
PRICE_LLM_INPUT_PER_MTOK=4.0
PRICE_LLM_OUTPUT_PER_MTOK=20.0

# ---- Privacidade ----
RECORDING_RETENTION_DAYS=30
STORAGE_DIR=./storage
